# Copie para .env e preencha. O .env NÃO deve ser versionado.

# --- Dify (edição community, self-hosted via Docker) ---
# Na instalação padrão (docker compose em ~/dify/docker) a API fica em http://localhost/v1
DIFY_API_URL=http://localhost/v1
# Chave da APLICAÇÃO de chat (Studio > app > "API Access" > "API Key"), formato app-xxxx
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx
DIFY_USER=robot-tests
DIFY_TIMEOUT=120

# --- Plano gratuito do Gemini: ritmo das chamadas ---
# Pausa antes de cada pergunta (s). Ex.: com limite de 15 req/min, use 4.
DIFY_INTERVALO_S=4
# Quando o Gemini recusa por cota, espera DIFY_ESPERA_BASE_S, depois o dobro, ... até DIFY_MAX_TENTATIVAS.
DIFY_MAX_TENTATIVAS=5
DIFY_ESPERA_BASE_S=15

# --- Critérios de aceitação ---
LIMITE_LATENCIA_S=30
LIMITE_SIMILARIDADE_CONSISTENCIA=0.5
REPETICOES_CONSISTENCIA=3

# --- Arquivo onde cada resposta do SUT é registrada (insumo do Ragas) ---
RESULTADOS_JSONL=results/respostas.jsonl

# --- LLM juiz do Ragas: Gemini pelo endpoint compatível com OpenAI ---
# Modelo diferente e mais capaz que o do chatbot (gemini-3.5-flash-lite), para reduzir o viés de
# o mesmo modelo avaliar as próprias respostas. Pode ser a mesma chave do AI Studio usada no Dify.
RAGAS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
RAGAS_LLM_MODEL=gemini-3.5-flash
RAGAS_LLM_API_KEY=sua-chave-do-ai-studio
# Paralelismo baixo e retentativas longas para caber no limite por minuto
RAGAS_MAX_WORKERS=2
RAGAS_MAX_RETRIES=10
RAGAS_MAX_WAIT_S=120
